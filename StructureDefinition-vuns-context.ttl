           ]
         ] [
           fhir:url [ fhir:v "http://hl7.org/fhir/StructureDefinition/elementdefinition-isCommonBinding"^^xsd:anyURI ] ;
           fhir:value [
             a fhir:boolean ;
             fhir:v true
           ]
         ] ) ;
         fhir:strength [ fhir:v "required" ] ;
